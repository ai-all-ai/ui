{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": "dist",
    "types": ["vite/client"],
    "paths": {
      "@ai.all/ui/dev-tools": ["./runtime/dev-tools.ts"]
    }
  },
  "include": ["components/ui/*.vue", "runtime/dev-tools.ts"]
}
