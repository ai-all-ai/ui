{
  "name": "@ai.all/ui",
  "version": "0.4.0-beta.0",
  "description": "Universal monochrome UI foundation, design tokens, and living pattern catalog for DS7 web projects",
  "keywords": [
    "design-system",
    "ui-kit",
    "components",
    "vue",
    "nuxt",
    "atomic-design",
    "brandbook",
    "design-tokens",
    "accessibility"
  ],
  "homepage": "https://github.com/ai-all-ai/ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-all-ai/ui.git"
  },
  "bugs": {
    "url": "https://github.com/ai-all-ai/ui/issues"
  },
  "license": "MIT",
  "author": "Igor Orlov",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./styled/*": {
      "types": "./dist/components/ui/*.vue.d.ts",
      "import": "./dist/styled/*.mjs"
    },
    "./components/*.vue": "./components/*.vue",
    "./components/*": {
      "types": "./dist/components/ui/*.vue.d.ts",
      "import": "./dist/components/*.mjs"
    },
    "./styles.css": "./dist/styles/all.css",
    "./styles/*": "./dist/styles/*",
    "./tokens/*": "./tokens/*",
    "./templates/*": "./templates/*",
    "./bin/*": "./bin/*",
    "./aiall-pack.json": "./aiall-pack.json",
    "./package.json": "./package.json",
    "./nuxt": {
      "types": "./nuxt/module.d.ts",
      "import": "./nuxt/module.mjs"
    },
    "./dev-tools": {
      "types": "./dist/runtime/dev-tools.d.ts",
      "import": "./dist/runtime/dev-tools.mjs"
    }
  },
  "bin": {
    "ui": "bin/ui.js"
  },
  "files": [
    "bin/",
    "components/",
    "gallery/",
    "tokens/",
    "templates/",
    "aiall-pack.json",
    "ALL.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "nuxt/",
    "runtime/",
    "dist/"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "npm run build && nuxt dev --port 3333",
    "test": "node scripts/test.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:one": "node --test",
    "check": "node bin/ui.js check",
    "check:strict": "node bin/ui.js check --strict",
    "format": "npx --yes prettier@3.6.2 --write \"**/*.{js,mjs,cjs,ts,vue,json,yml,yaml}\"",
    "format:check": "npx --yes prettier@3.6.2 --check \"**/*.{js,mjs,cjs,ts,vue,json,yml,yaml}\"",
    "prepublishOnly": "npm run format:check && npm test && npm run check:strict",
    "verify": "npm run format:check && npm test && npm run check:strict && npm run test:package",
    "release:check": "bash scripts/release-check.sh",
    "build": "node scripts/build.mjs && vue-tsc -p tsconfig.build.json",
    "prepack": "npm run --silent build",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "devDependencies": {
    "@vue/compiler-sfc": "3.5.46",
    "esbuild": "0.28.2",
    "lighthouse": "13.6.0",
    "nuxt": "^4.0.0",
    "playwright": "1.65.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "vue-router": "5.5.1"
  },
  "peerDependencies": {
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "sideEffects": [
    "**/*.css",
    "**/*.vue",
    "./dist/styled/*.mjs"
  ]
}
