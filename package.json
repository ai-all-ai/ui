{
  "name": "@ai.all/ui",
  "version": "0.2.0-beta.1",
  "description": "Universal monochrome UI foundation, design tokens, and living pattern catalog for DS7 web projects",
  "keywords": [
    "design-system",
    "ui-kit",
    "components",
    "vue",
    "nuxt",
    "atomic-design",
    "brandbook",
    "design-tokens",
    "accessibility"
  ],
  "homepage": "https://github.com/ai-all-ai/ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-all-ai/ui.git"
  },
  "bugs": {
    "url": "https://github.com/ai-all-ai/ui/issues"
  },
  "license": "MIT",
  "author": "Igor Orlov",
  "type": "module",
  "exports": {
    "./components/*": "./components/*",
    "./tokens/*": "./tokens/*",
    "./templates/*": "./templates/*",
    "./bin/*": "./bin/*",
    "./aiall-pack.json": "./aiall-pack.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "ui": "bin/ui.js"
  },
  "files": [
    "bin/",
    "components/",
    "tokens/",
    "templates/",
    "aiall-pack.json",
    "ALL.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "nuxt dev --port 3333",
    "test": "node scripts/test.mjs",
    "test:one": "node --test",
    "check": "node bin/ui.js check",
    "check:strict": "node bin/ui.js check --strict",
    "format": "npx --yes prettier@3.6.2 --write \"**/*.{js,mjs,cjs,ts,vue,json,yml,yaml}\"",
    "format:check": "npx --yes prettier@3.6.2 --check \"**/*.{js,mjs,cjs,ts,vue,json,yml,yaml}\"",
    "prepublishOnly": "npm run format:check && npm test && npm run check:strict",
    "verify": "npm run format:check && npm test && npm run check:strict && npm pack --dry-run",
    "release:check": "bash scripts/release-check.sh"
  },
  "devDependencies": {
    "nuxt": "^4.0.0"
  },
  "overrides": {
    "vue-router": "5.5.1"
  }
}
